{
  "name": "decode-action-template-project",
  "private": true,
  "version": "0.1.0",
  "description": "Directory-based AST deobfuscation template inspired by Decode_action-main",
  "scripts": {
    "decode": "node src/main.js -i input.js -o output.js",
    "deobfuscate": "node src/main.js",
    "decode:input": "node src/main.js",
    "metrics": "node src/tools/collect-residue-metrics.js",
    "compare": "node src/tools/compare-with-reference.js",
    "check": "node tests/static-contract.test.js",
    "test": "node tests/static-contract.test.js && node tests/pipeline.test.js"
  },
  "dependencies": {
    "@babel/generator": "^7.27.0",
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "@babel/types": "^7.27.0"
  }
}
