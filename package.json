    "NicerAver"
  ],
  "forkOf": "https://github.com/ZiChuanLan/pi-purge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicerAver/pi-purge-pro.git"
  },
  "homepage": "https://github.com/NicerAver/pi-purge-pro#readme",
  "bugs": {
    "url": "https://github.com/NicerAver/pi-purge-pro/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "system-prompt",
    "prompt-engineering",
    "prompt-evaluation"
  ],
  "files": [
    "extensions",
    "skills",
    "test",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
